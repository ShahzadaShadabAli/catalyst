# Copy this file to .env.local and fill it in. Never put real values in THIS file:
# .env.example is committed to git.

# ── Public site URL (used for metadata and the sitemap)
NEXT_PUBLIC_SITE_URL=https://catalystcollective.org

# ── Firebase / Firestore (Project settings → Service accounts → Generate new private key)
# Copy these three straight from the downloaded JSON file. SECRET.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Cloudinary (Dashboard → API Keys). API secret is SECRET.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=catalyst-collective

# ── Random secret used to hash visitor IPs for rate limiting. SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# ── Only while creating an admin (npm run create-admin -- <username>), then delete this line.
# ADMIN_PASSWORD=

# ── Local development with the Firestore emulator only (leave unset in production)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
