{
  "name": "catalyst-collective",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only firestore --project demo-catalyst",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-catalyst \"vitest run\"",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "remove-admin": "tsx --env-file=.env.local scripts/remove-admin.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "firebase": "^13.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "lenis": "^1.3.27",
    "motion": "^14.4.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
